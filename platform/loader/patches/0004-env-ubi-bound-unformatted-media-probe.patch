Subject: [PATCH] env: ubi: do not scan unformatted media for the environment

Loading the environment attaches UBI on `system`. On a unit still holding
stock data that is a full-device scan with no output before the first
prompt. First read only the EC, VID and layout headers, reporting progress,
and attach only when they hold UBI; otherwise use the default environment.

--- a/env/ubi.c
+++ b/env/ubi.c
@@ -7,6 +7,7 @@
 #include <asm/global_data.h>
 
 #include <command.h>
+#include <mtd.h>
 #include <env.h>
 #include <env_internal.h>
 #include <errno.h>
@@ -31,12 +32,94 @@
 #define ENV_UBI_VOLUME_REDUND "invalid"
 #endif
 
+/*
+ * Loading an environment from an unformatted, non-empty partition makes UBI
+ * scan the whole device before it can reject the media.  On the W1700K this
+ * happens before the first prompt, while "dev" still contains the stock OS.
+ * Bound that first-boot decision to eight good eraseblocks.  A formatted UBI
+ * device has two layout-volume PEBs with valid EC headers; random stock data or
+ * erased media cannot authorize the full attach merely by resembling one.
+ *
+ * This probe is deliberately load/save/erase admission only.  `ubi part dev`
+ * remains the explicit operation that formats an erased development partition.
+ */
+#define ENV_UBI_PROBE_GOOD_PEBS 8
+#define ENV_UBI_REQUIRED_EC_HEADERS 2
+
+int env_ubi_media_ready(void)
+{
+	struct mtd_info *mtd;
+	struct ubi_ec_hdr hdr;
+	unsigned int checked = 0, valid = 0;
+	loff_t offset;
+	size_t retlen;
+	int ret;
+
+	ret = mtd_probe_devices();
+	if (ret)
+		return ret;
+	mtd = get_mtd_device_nm(CONFIG_ENV_UBI_PART);
+	if (IS_ERR(mtd))
+		return PTR_ERR(mtd);
+
+	for (offset = 0; offset < mtd->size &&
+	     checked < ENV_UBI_PROBE_GOOD_PEBS; offset += mtd->erasesize) {
+		u32 crc;
+
+		ret = mtd_block_isbad(mtd, offset);
+		if (ret < 0)
+			goto out;
+		if (ret)
+			continue;
+		checked++;
+		retlen = 0;
+		ret = mtd_read(mtd, offset, sizeof(hdr), &retlen, (u8 *)&hdr);
+		if (ret && !mtd_is_bitflip(ret))
+			goto out;
+		if (retlen != sizeof(hdr)) {
+			ret = -EIO;
+			goto out;
+		}
+		crc = crc32_le(UBI_CRC32_INIT, (u8 *)&hdr, UBI_EC_HDR_SIZE_CRC);
+		if (be32_to_cpu(hdr.magic) == UBI_EC_HDR_MAGIC &&
+		    hdr.version == UBI_VERSION &&
+		    be32_to_cpu(hdr.hdr_crc) == crc &&
+		    ++valid == ENV_UBI_REQUIRED_EC_HEADERS) {
+			ret = 1;
+			goto out;
+		}
+	}
+	ret = 0;
+out:
+	put_mtd_device(mtd);
+	return ret;
+}
+
+static int env_ubi_preflight(const char *operation)
+{
+	int ret = env_ubi_media_ready();
+
+	if (ret > 0)
+		return 0;
+	if (!ret) {
+		printf("\n** No bounded UBI signature in %s; refusing environment %s **\n",
+		       CONFIG_ENV_UBI_PART, operation);
+		return -ENOMSG;
+	}
+	printf("\n** UBI media probe failed for %s (%d); refusing environment %s **\n",
+	       CONFIG_ENV_UBI_PART, ret, operation);
+	return ret;
+}
+
 #ifdef CONFIG_ENV_REDUNDANT
 static int env_ubi_save(void)
 {
 	ALLOC_CACHE_ALIGN_BUFFER(env_t, env_new, 1);
 	int ret;
 
+	ret = env_ubi_preflight("save");
+	if (ret)
+		return ret;
 	ret = env_export(env_new);
 	if (ret)
 		return ret;
@@ -83,6 +166,9 @@
 	ALLOC_CACHE_ALIGN_BUFFER(env_t, env_new, 1);
 	int ret;
 
+	ret = env_ubi_preflight("save");
+	if (ret)
+		return ret;
 	ret = env_export(env_new);
 	if (ret)
 		return ret;
@@ -109,6 +195,7 @@
 	ALLOC_CACHE_ALIGN_BUFFER(char, env2_buf, CONFIG_ENV_SIZE);
 	int read1_fail, read2_fail;
 	env_t *tmp_env1, *tmp_env2;
+	int ret;
 
 	/*
 	 * In case we have restarted u-boot there is a chance that buffer
@@ -125,6 +212,12 @@
 	tmp_env1 = (env_t *)env1_buf;
 	tmp_env2 = (env_t *)env2_buf;
 
+	ret = env_ubi_preflight("load");
+	if (ret) {
+		env_set_default(NULL, 0);
+		return ret;
+	}
+
 	if (ubi_part(CONFIG_ENV_UBI_PART, UBI_VID_OFFSET)) {
 		printf("\n** Cannot find mtd partition \"%s\"\n",
 		       CONFIG_ENV_UBI_PART);
@@ -151,6 +244,7 @@
