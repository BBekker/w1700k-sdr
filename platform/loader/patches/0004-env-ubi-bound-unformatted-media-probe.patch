 {
 	ALLOC_CACHE_ALIGN_BUFFER(char, buf, CONFIG_ENV_SIZE);
+	int ret;
 
 	/*
 	 * In case we have restarted u-boot there is a chance that buffer
@@ -162,6 +256,12 @@
 	 */
 	memset(buf, 0x0, CONFIG_ENV_SIZE);
 
+	ret = env_ubi_preflight("load");
+	if (ret) {
+		env_set_default(NULL, 0);
+		return ret;
+	}
+
 	if (ubi_part(CONFIG_ENV_UBI_PART, UBI_VID_OFFSET)) {
 		printf("\n** Cannot find mtd partition \"%s\"\n",
 		       CONFIG_ENV_UBI_PART);
@@ -185,8 +285,12 @@
 static int env_ubi_erase(void)
 {
 	ALLOC_CACHE_ALIGN_BUFFER(char, env_buf, CONFIG_ENV_SIZE);
-	int ret = 0;
+	int ret;
 
+	ret = env_ubi_preflight("erase");
+	if (ret)
+		return ret;
+	ret = 0;
 	if (ubi_part(CONFIG_ENV_UBI_PART, UBI_VID_OFFSET)) {
 		printf("\n** Cannot find mtd partition \"%s\"\n",
 		       CONFIG_ENV_UBI_PART);
