SPDX-License-Identifier: GPL-2.0+
Subject: [PATCH] mtd: nand: attach the vendor BMT translation layer

Stock U-Boot addresses this SPI-NAND through the vendor's bad-block tables:
a factory BBT shifts logical blocks past bad ones and a BMT substitutes worn
blocks from a reserve pool. Add CONFIG_AIROHA_BMT, which builds the shared
translation core (airoha_bmt.c) and its MTD binding (airoha_bmt_layer.c), and
attach it in the spinand probe, so the `mtd` and `ubi` commands reach the
same physical blocks as stock's `flash` commands, including the loader
partition stock boots from.

This is not OpenWrt's mtk_bmt: that driver computes a different pool size,
fails the vendor checksum, and then rewrites the table.

--- a/drivers/mtd/nand/Kconfig
+++ b/drivers/mtd/nand/Kconfig
@@ -4,3 +4,11 @@
 source "drivers/mtd/nand/raw/Kconfig"
 
 source "drivers/mtd/nand/spi/Kconfig"
+
+config AIROHA_BMT
+	bool "Airoha vendor BMT/BBT translation (read side)"
+	depends on MTD_SPI_NAND
+	help
+	  Translate logical to physical NAND blocks through the vendor factory
+	  BBT shift and BMT substitution, so writes land where stock U-Boot's
+	  flash read looks. Read side only; it never writes the reserve pool.
--- a/drivers/mtd/nand/Makefile
+++ b/drivers/mtd/nand/Makefile
@@ -5,6 +5,7 @@
 obj-$(CONFIG_MTD_NAND_CORE) += nandcore.o
 obj-$(CONFIG_MTD_RAW_NAND) += raw/
 obj-$(CONFIG_MTD_SPI_NAND) += spi/
+obj-$(CONFIG_AIROHA_BMT) += airoha_bmt.o airoha_bmt_layer.o
 else
 obj-$(CONFIG_$(PHASE_)NAND_SUPPORT) += raw/
 endif
--- a/drivers/mtd/nand/spi/core.c
+++ b/drivers/mtd/nand/spi/core.c
@@ -1662,6 +1662,12 @@
 	return 0;
 }
 
+#if IS_ENABLED(CONFIG_AIROHA_BMT)
+/* platform/bmt translation layer, wired in by the loader build. */
+int airoha_bmt_attach(struct mtd_info *mtd);
+void airoha_bmt_detach(struct mtd_info *mtd);
+#endif
+
 static int spinand_probe(struct udevice *dev)
 {
 	struct spinand_device *spinand = dev_get_priv(dev);
@@ -1700,6 +1706,12 @@
 	if (ret)
 		return ret;
 
+#if IS_ENABLED(CONFIG_AIROHA_BMT)
+	ret = airoha_bmt_attach(mtd);
+	if (ret)
+		goto err_spinand_cleanup;
+#endif
+
 #ifndef __UBOOT__
 	ret = mtd_device_register(mtd, NULL, 0);
 #else
@@ -1713,6 +1725,9 @@
 	return 0;
 
 err_spinand_cleanup:
+#if IS_ENABLED(CONFIG_AIROHA_BMT)
+	airoha_bmt_detach(mtd);
+#endif
 	spinand_cleanup(spinand);
 
 	return ret;
