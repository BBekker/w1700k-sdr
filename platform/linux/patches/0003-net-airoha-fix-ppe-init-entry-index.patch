Subject: [PATCH] net: airoha: fix PPE entry indexing and init error propagation

PPE initialisation clears SRAM entries through a typed airoha_foe_entry
pointer, so index it in entries, not bytes. Return a failed SRAM write to the
caller instead of shadowing its status, and fix the same indexing in the
commit helper.

--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -750,7 +750,7 @@
 
 static int airoha_ppe_foe_commit_sram_entry(struct airoha_ppe *ppe, u32 hash)
 {
-	struct airoha_foe_entry *hwe = ppe->foe + hash * sizeof(*hwe);
+	struct airoha_foe_entry *hwe = ppe->foe + hash;
 	bool ppe2 = hash >= PPE_SRAM_NUM_ENTRIES;
 	u32 *ptr = (u32 *)hwe, val;
 	int i;
@@ -774,7 +774,7 @@
 				       u32 hash, bool rx_wlan)
 {
 	u32 sram_num_entries = airoha_ppe_get_total_sram_num_entries(ppe);
-	struct airoha_foe_entry *hwe = ppe->foe + hash * sizeof(*hwe);
+	struct airoha_foe_entry *hwe = ppe->foe + hash;
 	u32 ts = airoha_ppe_get_timestamp(ppe);
 	struct airoha_eth *eth = ppe->eth;
 	struct airoha_npu *npu;
@@ -1397,8 +1397,6 @@
 	int i, err = 0;
 
 	for (i = 0; i < sram_num_entries; i++) {
-		int err;
-
 		memset(&hwe[i], 0, sizeof(*hwe));
 		err = airoha_ppe_foe_commit_sram_entry(ppe, i);
 		if (err)
