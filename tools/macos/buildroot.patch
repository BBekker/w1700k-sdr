diff --git a/package/makedevs/makedevs.c b/package/makedevs/makedevs.c
index be76155a..e7ec5298 100644
--- a/package/makedevs/makedevs.c
+++ b/package/makedevs/makedevs.c
@@ -257,8 +257,42 @@ char *bb_get_chomped_line_from_file(FILE *file)
 	return private_get_line_from_file(file, 1);
 }
 
+#ifdef __APPLE__
+/* Read target IDs from the staged Linux files, never the host account database. */
+static long target_account_id(const char *path, const char *name)
+{
+    FILE *stream = bb_xfopen(path, "r");
+    char *line = NULL;
+    size_t capacity = 0;
+    long result = -1;
+    while (getline(&line, &capacity, stream) >= 0) {
+        char *rest = line;
+        char *account = strsep(&rest, ":");
+        char *password = strsep(&rest, ":");
+        char *number = strsep(&rest, ":");
+        char *end;
+        if (!account || !password || !number || strcmp(account, name))
+            continue;
+        errno = 0;
+        unsigned long id = strtoul(number, &end, 10);
+        if (errno || end == number || *end || id > 0xffffffffUL)
+            bb_error_msg_and_die("invalid target account ID for %s", name);
+        result = (long)id;
+        break;
+    }
+    free(line);
+    fclose(stream);
+    if (result < 0)
+        bb_error_msg_and_die("unknown target account name: %s", name);
+    return result;
+}
+#endif
+
 long my_getpwnam(const char *name)
 {
+#ifdef __APPLE__
+    return target_account_id(PASSWD_PATH, name);
+#else
 	struct passwd *myuser;
 	FILE *stream;
 
@@ -276,10 +310,14 @@ long my_getpwnam(const char *name)
 	fclose(stream);
 
 	return myuser->pw_uid;
+#endif
 }
 
 long my_getgrnam(const char *name)
 {
+#ifdef __APPLE__
+    return target_account_id(GROUP_PATH, name);
+#else
 	struct group *mygroup;
 	FILE *stream;
 
@@ -297,6 +335,7 @@ long my_getgrnam(const char *name)
 	fclose(stream);
 
 	return mygroup->gr_gid;
+#endif
 }
 
 unsigned long get_ug_id(const char *s, long (*my_getxxnam)(const char *))
