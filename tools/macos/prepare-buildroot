#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Apply the native Darwin host adaptations to the pinned Buildroot checkout."""
from pathlib import Path
import subprocess
import sys

source = Path(sys.argv[1])
patch = Path(__file__).with_name('buildroot.patch').resolve()
command = ['git', '-C', str(source), 'apply']
if subprocess.run([*command, '--reverse', '--check', str(patch)], capture_output=True).returncode:
    subprocess.run([*command, '--check', str(patch)], check=True)
    subprocess.run([*command, str(patch)], check=True)
